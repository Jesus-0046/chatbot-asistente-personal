# ============ Entorno ============
APP_ENV=development
LOG_LEVEL=INFO
# DEBUG=true  # si se desea log SQLAlchemy/echo

# ============ Base de datos ============
POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente_secreto_cambiar
POSTGRES_DB=asistente
POSTGRES_PORT=5432
# URL usada por la app y por Alembic (driver async).
# En Docker se sobreescribe la del servicio `bot` apuntando al host `db`.
DATABASE_URL=postgresql+asyncpg://asistente:asistente_secreto_cambiar@localhost:5432/asistente

# ============ Telegram ============
# Token del bot (NUNCA comitearlo; se genera con @BotFather).
TELEGRAM_TOKEN=
# IDs de Telegram autorizados, formato JSON list.
# Se obtienen con @userinfobot o similar.
OWNER_TELEGRAM_IDS=[]

# ============ OpenAI / Ollama local ============
# API key (NUNCA comitearla). Obligatoria SOLO contra la API oficial de OpenAI;
# con OPENAI_BASE_URL configurada (proveedor local compatible, p. ej. Ollama)
# puede quedar vacía. Obtenerla en https://platform.openai.com/api-keys
OPENAI_API_KEY=
# URL base opcional compatible con la API de OpenAI (vacío = API oficial).
# Ollama local desde el contenedor Docker (host.docker.internal solo resuelve
# dentro del contenedor, no en la PC):
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Ollama en la misma PC sin Docker:
#   OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
# Modelo a usar (debe soportar function calling).
# Ej.: gpt-4o-mini (OpenAI) o qwen3:8b (Ollama local, capacidad "tools").
OPENAI_MODEL=gpt-4o-mini
# Timeout de cada llamada al LLM en segundos (modelos locales 8B pueden
# tardar >60 s con el registro completo de herramientas: súbelo en modo local)
OPENAI_TIMEOUT_SECONDS=60
# Reintentos automáticos del SDK ante errores transitorios de red/5xx
# (en modo local un reintento tras timeout solo alarga la espera: 0 recomendado)
OPENAI_MAX_RETRIES=2
# Tokens máximos por respuesta (0 = sin límite explícito por la app)
OPENAI_MAX_TOKENS=0

# ============ Conversación ============
# Máximo de iteraciones LLM→tools por mensaje
LLM_MAX_TOOL_ITERATIONS=5
# Ventana de historial (mensajes recientes) que se envía al LLM
CONVERSATION_WINDOW_SIZE=40
# TTL de una confirmación pendiente en minutos
CONFIRMATION_TTL_MINUTES=10

# ============ Rate limiting (in-memory, por usuario) ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=30

# ============ Perfil por defecto ============
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LANG=es-ES

# ============ Agenda y recordatorios (Fase 2) ============
# Intervalo del poller de recordatorios en segundos (JobQueue de PTB/apscheduler)
REMINDER_POLLER_INTERVAL_SECONDS=30
# Ventana de recuperación: recordatorios vencidos más antiguos se cancelan
REMINDER_RECOVERY_WINDOW_MINUTES=60
# Tamaño de lote por pasada del poller
REMINDER_BATCH_SIZE=20
# Lease del claim atómico (segundos): cuánto dura un `processing` antes de que
# otro worker recupere un recordatorio cuya entrega no se confirmó (crash)
REMINDER_CLAIM_LEASE_SECONDS=300
# Hora por defecto cuando se pide una fecha sin hora (formato 24h)
DEFAULT_REMINDER_HOUR=9
# Anticipación por defecto de un recordatorio vinculado a evento/tarea (minutos)
DEFAULT_REMINDER_OFFSET_MINUTES=60

# ============ Imágenes / OCR (Fase 7) ============
# Tamaño máximo de imagen a analizar en MB (los bytes nunca se persisten)
IMAGE_MAX_SIZE_MB=10
# Máximo de imágenes por mensaje
IMAGE_MAX_PER_MESSAGE=1
# Longitud máxima del contenido extraído (caracteres)
IMAGE_MAX_EXTRACTED_CHARS=20000
# Timeout del análisis visual en segundos
IMAGE_TIMEOUT_SECONDS=30
# Formatos de imagen admitidos (JSON list)
IMAGE_ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "image/webp"]

# ============ WhatsApp Cloud API (Fase 9) ============
# Segundo canal oficial por webhook HTTP. Con WHATSAPP_ENABLED=false la app
# arranca solo con Telegram y sin servidor webhook. NUNCA comitear secretos.
WHATSAPP_ENABLED=false
# Token de verificación del webhook (lo eliges tú en Meta Developer).
WHATSAPP_VERIFY_TOKEN=
# Token permanente de acceso a la Graph API ("permanent token", NUNCA el de prueba).
WHATSAPP_ACCESS_TOKEN=
# App secret de la app de Meta: firma X-Hub-Signature-256 de cada webhook POST.
WHATSAPP_APP_SECRET=
# ID numérico de tu número de teléfono en Meta (sin el + y sin el país).
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API y URL base.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Interfaz de escucha del webhook: en Docker/servidor usa 0.0.0.0 (el reverse
# proxy alcanza al contenedor); en el PC local deja 127.0.0.1.
WHATSAPP_WEBHOOK_HOST=127.0.0.1
# Puerto local del servidor webhook (recomendado: expone solo vía reverse proxy
# o túnel; el webhook nunca escucha en la WAN directamente).
WHATSAPP_WEBHOOK_PORT=8088
# Timeout de cada llamada a la Graph API en segundos (nunca timeout infinito).
WHATSAPP_HTTP_TIMEOUT_SECONDS=30

# ============ Web API (Fase 10.0) ============
# Capa HTTP autenticada (sesiones persistentes Bearer). Es un proceso SEPARADO
# que comparte el mismo PostgreSQL; API_ENABLED es un interruptor operacional,
# no de seguridad. El puerto es distinto del webhook de WhatsApp (8088).
API_ENABLED=false
# En Docker/servidor usa 0.0.0.0 (el reverse proxy alcanza al contenedor);
# en el PC local deja 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8000
# Swagger/OpenAPI en /docs + /redoc. En producción desactívalo (false).
API_DOCS_ENABLED=false
# Orígenes CORS permitidos, formato JSON list de bases (NO asterisco con auth).
# Ej. API_CORS_ORIGINS=["https://app.midominio.com"]
API_CORS_ORIGINS=[]
# TTL de una sesión Web en días y de un código de enlace (tool link_web) en minutos.
WEB_SESSION_TTL_DAYS=30
WEB_BINDING_TTL_MINUTES=30
# Longitud mínima de contraseña al registrar/vincular.
WEB_PASSWORD_MIN_LENGTH=8
# Rate limit por IP sobre /api/v1/auth/* (en memoria de proceso).
API_RATE_LIMIT_AUTH_PER_MINUTE=10
API_RATE_LIMIT_REGISTER_PER_MINUTE=5

# ============ Proactividad (Fase 6) — uso bajo demanda ============
# Poller de proactividad (OPT-IN por usuario). Leer las secciones de
# DEPLOYMENT.md/OPERATIONS.md antes de activarlo.
# PROACTIVE_POLLER_INTERVAL_SECONDS=300
# PROACTIVE_MAX_USERS_PER_RUN=500
# PROACTIVE_NOTIFICATION_LEASE_SECONDS=600

# ============ Backup / restauración (Fase 10.1) ============
# Usados por scripts/backup.sh, scripts/restore.sh y scripts/verify_backup.sh
# (ver BACKUP_RESTORE.md). En el PC local, los binarios pg suelen estar en
# C:\Program Files\PostgreSQL\16\bin (ajústalos o añádelos al PATH).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Host/puerto de PostgreSQL para las herramientas de backup. En Docker el
# servicio `db` responde por el nombre del servicio; en local por localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Nombre de BD scratch usada por restore.sh/verify_backup.sh para probar una
# restauración SIN tocar la BD de producción.
BACKUP_TEST_DBNAME=asistente_restore_test